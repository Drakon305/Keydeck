        {
          "label": "Hello",
          "hotkey": "",
          "text": "Hello!{, welcome in! Glad you made it.| and welcome! Make yourself at home.|! Great to have you here.|, welcome aboard! Pull up a chair.| there, welcome! Hope you enjoy your stay.}",
          "mode": "paste",
          "enter": true,
          "enabled": true,
          "color": "#16a085",
          "action": "text",
          "goto": "",
          "cmd": "/reply",
          "opt1": "",
          "opt2": "",
          "opt3": ""
        },
        {
          "label": "Thank you message",
          "hotkey": "alt+3",
          "text": "Thank you for playing Brits PVE Worlds. We are happy to have you here. If you need further assistance please feel free to open a ticket and one of our staff members will be happy to assist you.",
